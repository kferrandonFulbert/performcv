<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block description %}  <meta name="description" content="Créez un CV à votre image et partagez votre parcours professionnel avec PerformCV.">
        {% endblock %}
        <title>{% block title %}PerformCV{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <script src="{{ asset('ui.js') }}" defer></script>
        {% block stylesheets %}{% endblock %}
        <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-PV3L5P45"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">Aller au contenu</a>
        <header class="site-header"><a class="brand" href="{{ path('app_home') }}" aria-label="PerformCV, accueil"><span class="brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H5v20h14V7l-5-5Zm0 0v5h5M8 12h8m-8 4h6"/></svg></span>perform<span>cv</span><span class="brand-dot">.</span></a><nav aria-label="Navigation principale">{% if app.user %}<a href="{{ path('app_dashboard') }}" {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'aria-current="page"' : '' }}>Mon espace</a><a href="{{ path('app_account') }}">Mon compte</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="link" type="submit">Déconnexion ↗</button></form>{% else %}<a href="{{ path('app_login') }}">Se connecter</a><a class="button small" href="{{ path('app_register') }}">Commencer ↗</a>{% endif %}</nav></header>
        <main id="main" class="site-main">{% for type, messages in app.flashes %}{% for message in messages %}<div class="notice {{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main>
        <footer class="site-footer"><a class="brand" href="{{ path('app_home') }}">perform<span>cv</span>.</a><p>Votre parcours. Vos perspectives.</p><a href="{{ path('app_privacy') }}">Confidentialité</a></footer>
    </body>
</html>
