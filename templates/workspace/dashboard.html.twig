{% extends 'base.html.twig' %}
{% block title %}Mon espace — PerformCV{% endblock %}
{% block body %}<header class="page-heading"><div><p class="eyebrow">VOTRE ESPACE PERSONNEL</p><h1>Bonjour {{ app.user.firstName ?: 'à vous' }}<span class="accent">.</span></h1><p class="lead">Chaque profil, une nouvelle façon de raconter votre parcours.</p></div><a class="button" href="{{ path('app_profile_new') }}">+ Nouveau profil</a></header><div class="section-heading"><h2>Mes profils</h2><span class="muted">Votre point de départ</span></div><div class="profile-grid">{% for profile in profiles %}<article class="profile-card"><div class="card-top"><span class="profile-number">{{ '%02d'|format(loop.index + (page - 1) * 20) }}</span><span class="badge {{ profile.isPublic == 1 ? 'public' : '' }}">{{ profile.isPublic == 1 ? 'Public' : 'Privé' }}</span></div><h2><a href="{{ path('app_profile_show', {id: profile.id}) }}">{{ profile.title ?: 'Mon profil' }}</a></h2><p>{{ profile.summary ? profile.summary|slice(0, 145) ~ (profile.summary|length > 145 ? '…' : '') : 'Commencez par ajouter les expériences qui vous définissent.' }}</p><div class="card-bottom"><span>{{ profile.location ?: 'Votre parcours professionnel' }}</span><a class="round-link" href="{{ path('app_profile_show', {id: profile.id}) }}" aria-label="Ouvrir {{ profile.title }}">↗</a></div></article>{% else %}<div class="empty-state"><span class="empty-icon" aria-hidden="true">↗</span><h2>Tout commence par votre parcours.</h2><p>Créez votre premier profil, puis transformez-le en un CV à votre image.</p><a class="button" href="{{ path('app_profile_new') }}">Créer mon premier profil</a></div>{% endfor %}</div><nav class="pagination" aria-label="Pagination des profils">{% if page > 1 %}<a href="{{ path('app_dashboard', {page: page - 1}) }}">← Précédent</a>{% endif %}<span>Page {{ page }}</span>{% if next %}<a href="{{ path('app_dashboard', {page: page + 1}) }}">Suivant →</a>{% endif %}</nav>{% endblock %}
