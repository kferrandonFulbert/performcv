{% extends 'base.html.twig' %}
{% block title %}{{ profile.title }} — PerformCV{% endblock %}
{% block body %}<a class="back" href="{{ path('app_dashboard') }}">← Mes profils</a><header class="page-heading"><div><p class="eyebrow">MON PARCOURS <span class="badge">{{ profile.isPublic == 1 ? 'Public' : 'Privé' }}</span></p><h1>{{ profile.title ?: 'Mon profil' }}</h1><p class="lead">{{ profile.summary }}</p>{% if profile.isPublic == 1 %}<a href="{{ path('app_public_profile', {slug: profile.slug}) }}">Voir le profil public ↗</a>{% endif %}</div><div class="actions"><a class="button secondary" href="{{ path('app_profile_edit', {id: profile.id}) }}">Modifier le profil</a><a class="button" href="{{ path('app_cv_new', {profileId: profile.id}) }}">Créer un CV ↗</a></div></header><div class="workspace-layout"><nav class="section-nav" aria-label="Rubriques"><span class="eyebrow">VOTRE PROFIL</span>{% for key, section in sections %}<a href="#{{ key }}">{{ section.label }}<span>{{ content[key]|length }}</span></a>{% endfor %}<a href="#mes-cv">Mes CV <span>{{ cvs|length }}</span></a></nav><div>{% for key, section in sections %}<section id="{{ key }}" class="section-panel"><div class="section-heading"><h2>{{ section.label }}</h2><a class="text-link" href="{{ path('app_entry_new', {profileId: profile.id, section: key}) }}">+ Ajouter</a></div>{% for entry in content[key] %}<article class="entry-row"><div>{% include 'cv/_entry.html.twig' with {key: key, entry: entry} %}</div><div class="entry-actions"><a href="{{ path('app_entry_edit', {profileId: profile.id, section: key, id: entry.id}) }}">Modifier</a><form method="post" action="{{ path('app_entry_delete', {profileId: profile.id, section: key, id: entry.id}) }}" data-confirm="Supprimer cet élément ?"><input type="hidden" name="_token" value="{{ csrf_token('delete_entry_' ~ key ~ '_' ~ entry.id) }}"><button class="link danger" type="submit">Supprimer</button></form></div></article>{% else %}<p class="empty-inline">Une nouvelle partie de votre histoire à raconter.</p>{% endfor %}</section>{% endfor %}<section id="mes-cv" class="section-panel"><div class="section-heading"><h2>Mes CV</h2><a class="text-link" href="{{ path('app_cv_new', {profileId: profile.id}) }}">+ Créer un CV</a></div>{% for cv in cvs %}<a class="cv-list-item" href="{{ path('app_cv_show', {id: cv.id}) }}"><span class="document-icon" aria-hidden="true">▤</span><div><strong>CV #{{ cv.id }}</strong><p>Mis à jour le {{ cv.updatedAt|date('d/m/Y') }} · {{ cv.colorScheme }}</p></div><span aria-hidden="true">↗</span></a>{% else %}<p class="empty-inline">Votre parcours est prêt à prendre forme. Créez votre premier CV.</p>{% endfor %}</section><div class="delete-zone"><h3>Supprimer ce profil</h3><p>Cette action supprime ses rubriques, ses CV, ses liens et ses statistiques.</p><form method="post" action="{{ path('app_profile_delete', {id: profile.id}) }}" data-confirm="Supprimer définitivement ce profil et tous ses CV ?"><input type="hidden" name="_token" value="{{ csrf_token('delete_profile_' ~ profile.id) }}"><button class="button danger-button" type="submit">Supprimer le profil</button></form></div></div></div>{% endblock %}
