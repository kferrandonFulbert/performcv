{% extends 'base.html.twig' %}
{% block title %}{{ title }} — PerformCV{% endblock %}
{% block body %}<div class="form-layout"><aside><a class="back" href="{{ back }}">← Retour</a><p class="eyebrow">{{ eyebrow }}</p><h1>{{ title }}</h1>{% if app.request.attributes.get('_route') == 'app_account' %}<p class="lead">Ces coordonnées apparaissent sur vos CV et profils publics.</p><p><a href="{{ path('app_password') }}">Changer mon mot de passe →</a></p><p><a class="danger" href="{{ path('app_account_delete') }}">Supprimer mon compte</a></p>{% else %}<p class="lead">Les détails font la différence. Prenez le temps de raconter ce qui vous distingue.</p>{% endif %}<div class="aside-mark" aria-hidden="true">P<span>↗</span></div></aside><section class="form-card">{{ form_start(form, {attr: {'data-turbo': 'false'}}) }}{{ form_errors(form) }}{{ form_widget(form) }}<button class="button full" type="submit">{{ button }} <span aria-hidden="true">↗</span></button>{{ form_end(form) }}</section></div>{% endblock %}
