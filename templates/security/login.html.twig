{% extends 'base.html.twig' %}
{% block title %}Connexion — PerformCV{% endblock %}
{% block body %}<div class="form-layout"><aside><p class="eyebrow">HEUREUX DE VOUS RETROUVER</p><h1>La suite de<br>votre histoire.</h1><p class="lead">Vos profils, vos CV et vos prochaines opportunités vous attendent.</p><div class="aside-mark" aria-hidden="true">P<span>↗</span></div></aside><section class="form-card"><h2>Se connecter</h2><p>Pas encore de compte ? <a href="{{ path('app_register') }}">Créer mon compte</a></p>{% if error %}<div class="notice error" role="alert">Connexion impossible. Vérifiez vos identifiants et réessayez.</div>{% endif %}<form method="post" action="{{ path('app_login') }}" data-turbo="false"><label for="email">Adresse email</label><input type="email" id="email" name="_username" value="{{ last_email }}" autocomplete="username" required maxlength="255"><label for="password">Mot de passe</label><input type="password" id="password" name="_password" autocomplete="current-password" required maxlength="128"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button full" type="submit">Se connecter <span aria-hidden="true">↗</span></button></form></section></div>{% endblock %}
