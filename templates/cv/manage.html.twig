{% extends 'cv/base.html.twig' %}
{% block title %}Mon CV — {{ profile.title }}{% endblock %}
{% block body %}<a class="back" href="{{ path('app_profile_show', {id: profile.id}) }}">← Mon profil</a><header class="page-heading"><div><p class="eyebrow">PRÊT POUR LA SUITE</p><h1>Votre CV<span class="accent">.</span></h1><p class="lead">Un document vivant, à l’image de votre parcours.</p></div><div class="actions"><a class="button secondary" href="{{ path('app_cv_edit', {id: cv.id}) }}">Personnaliser</a><button class="button secondary" type="button" data-print>Imprimer / PDF (ATS)</button><a class="button" href="{{ path('app_share_new', {id: cv.id}) }}">Partager ↗</a></div></header><div class="cv-workspace"><div class="preview-wrap">{% include 'cv/_print_help.html.twig' %}{% include 'cv/_document.html.twig' %}</div><aside class="share-panel"><p class="eyebrow">OUVREZ LA CONVERSATION</p>{% include 'directory/_publication.html.twig' %}<h2>Liens de partage</h2><p>Chaque lien a ses propres conditions d’accès. Le compteur anonyme indique les affichages réussis par ce lien, y compris les rechargements, sans identifier les visiteurs. Il ne représente pas des visiteurs uniques. La durée cible de conservation est de 90 jours, sous réserve de la purge quotidienne.</p>{% for share in shares %}<article class="share-card"><div class="card-top"><strong>Lien #{{ share.id }}</strong><span class="badge">{{ share.isPublic != 1 ? 'Désactivé' : (share.expiresAt and share.expiresAt <= date() ? 'Expiré' : 'Actif') }}</span></div><label for="share-{{ share.id }}">Adresse à partager</label><input id="share-{{ share.id }}" readonly value="{{ url('app_public_share', {token: share.shareToken}) }}"><a href="{{ path('app_public_share', {token: share.shareToken}) }}">Ouvrir le lien ↗</a><p>{{ share.passwordProtected == 1 ? 'Protégé par mot de passe' : 'Sans mot de passe' }}<br>{{ share.expiresAt ? 'Expire le ' ~ share.expiresAt|date('d/m/Y H:i') ~ ' UTC' : 'Sans expiration' }}</p><p class="view-count">{{ counts[share.id] ?? 0 }} <span>consultation(s)</span></p><form method="post" action="{{ path('app_share_delete', {id: cv.id, shareId: share.id}) }}" data-confirm="Révoquer ce lien et supprimer ses statistiques ?"><input type="hidden" name="_token" value="{{ csrf_token('delete_share_' ~ share.id) }}"><button class="link danger" type="submit">Révoquer le lien</button></form></article>{% else %}<p class="empty-inline">Aucun lien pour le moment.</p>{% endfor %}<a class="button full" href="{{ path('app_share_new', {id: cv.id}) }}">+ Créer un lien</a><div class="delete-zone"><form method="post" action="{{ path('app_cv_delete', {id: cv.id}) }}" data-confirm="Supprimer définitivement ce CV et ses liens ?"><input type="hidden" name="_token" value="{{ csrf_token('delete_cv_' ~ cv.id) }}"><button class="link danger" type="submit">Supprimer ce CV</button></form></div></aside></div>{% endblock %}
