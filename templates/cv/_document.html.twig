{% set cv_name_tag = editorial_example|default(false) ? 'h4' : 'h1' %}
{% set cv_section_tag = editorial_example|default(false) ? 'h5' : 'h2' %}
{% set cv_entry_tag = editorial_example|default(false) ? 'h6' : 'h3' %}
<article class="cv-document theme-{{ theme }} {{ is_preview ? 'is-preview' : '' }} layout-{{ layout }} palette-{{ color }} font-{{ font }}"><header class="cv-header">{% if profile_photo|default(null) %}<img class="cv-photo" src="{{ profile_photo }}" alt="Photo de profil" width="96" height="96">{% endif %}<p class="eyebrow">CURRICULUM VITAE</p><{{ cv_name_tag }}>{{ owner ? owner.firstName : '' }} {{ owner ? owner.lastName : '' }}</{{ cv_name_tag }}><p class="cv-job">{{ profile.title }}</p><div class="cv-contact">{% if profile.location %}<span>{{ profile.location }}</span>{% endif %}{% if owner %}<span>{{ owner.email }}</span>{% if owner.phone %}<span>{{ owner.phone }}</span>{% endif %}{% endif %}{% for label, url in {Site: profile.website, LinkedIn: profile.linkedinUrl, GitHub: profile.githubUrl} %}{% if url starts with 'https://' or url starts with 'http://' %}<a href="{{ url }}" rel="noopener noreferrer">{{ label }} : {{ url }}</a>{% endif %}{% endfor %}</div></header>{% if profile.summary %}<section class="cv-section cv-summary"><{{ cv_section_tag }}>Profil</{{ cv_section_tag }}><p>{{ profile.summary|nl2br }}</p></section>{% endif %}<div class="cv-sections">{% set labels = {experiences: 'Expériences professionnelles', educations: 'Formations', certifications: 'Certifications', projects: 'Projets', skills: 'Compétences', languages: 'Langues'} %}{% for key, entries in content %}{% if entries|length %}<section class="cv-section cv-{{ key }}"><{{ cv_section_tag }}>{{ labels[key] }}</{{ cv_section_tag }}>{% for entry in entries %}<div class="cv-entry">{% include 'cv/_entry.html.twig' with {key: key, entry: entry} %}</div>{% endfor %}</section>{% endif %}{% endfor %}</div></article>
