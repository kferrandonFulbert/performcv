<article class="cv-document layout-{{ layout }} palette-{{ color }} font-{{ font }}"><header class="cv-header"><p class="eyebrow">CURRICULUM VITAE</p><h1>{{ owner ? owner.firstName : '' }} {{ owner ? owner.lastName : '' }}</h1><p class="cv-job">{{ profile.title }}</p><div class="cv-contact">{% if profile.location %}<span>{{ profile.location }}</span>{% endif %}{% if owner %}<span>{{ owner.email }}</span>{% if owner.phone %}<span>{{ owner.phone }}</span>{% endif %}{% endif %}{% for label, url in {Site: profile.website, LinkedIn: profile.linkedinUrl, GitHub: profile.githubUrl} %}{% if url starts with 'https://' or url starts with 'http://' %}<a href="{{ url }}" rel="noopener noreferrer">{{ label }} ↗</a>{% endif %}{% endfor %}</div></header>{% if profile.summary %}<section class="cv-section cv-summary"><h2>Profil</h2><p>{{ profile.summary|nl2br }}</p></section>{% endif %}<div class="cv-sections">{% set labels = {experiences: 'Expériences', educations: 'Formations', certifications: 'Certifications', projects: 'Projets', skills: 'Compétences', languages: 'Langues'} %}{% for key, entries in content %}{% if entries|length %}<section class="cv-section cv-{{ key }}"><h2>{{ labels[key] }}</h2>{% for entry in entries %}<div class="cv-entry">{% include 'cv/_entry.html.twig' with {key: key, entry: entry} %}</div>{% endfor %}</section>{% endif %}{% endfor %}</div></article>
