{% if key == 'experiences' %}<h3>{{ entry.position ?: entry.companyName }}</h3><p class="entry-meta">{{ entry.companyName }}{% if entry.location %} · {{ entry.location }}{% endif %}</p><p class="entry-date">{{ entry.startDate ? entry.startDate|date('m/Y') : 'Date non précisée' }} — {{ entry.isCurrent == 1 ? 'Aujourd’hui' : (entry.endDate ? entry.endDate|date('m/Y') : 'Date non précisée') }}</p>{% if entry.description %}<p class="entry-description">{{ entry.description|nl2br }}</p>{% endif %}
{% elseif key == 'educations' %}<h3>{{ entry.degree ?: entry.institution }}</h3><p class="entry-meta">{{ entry.institution }}{% if entry.fieldOfStudy %} · {{ entry.fieldOfStudy }}{% endif %}</p><p class="entry-date">{{ entry.startDate ? entry.startDate|date('m/Y') : 'Date non précisée' }} — {{ entry.endDate ? entry.endDate|date('m/Y') : 'Date non précisée' }}</p>{% if entry.description %}<p class="entry-description">{{ entry.description|nl2br }}</p>{% endif %}
{% elseif key == 'certifications' %}<h3>{{ entry.name }}</h3><p class="entry-meta">{{ entry.issuingOrganization }}</p>{% if entry.issueDate %}<p class="entry-date">Obtenue en {{ entry.issueDate|date('m/Y') }}{% if entry.expirationDate %} · Expire en {{ entry.expirationDate|date('m/Y') }}{% endif %}</p>{% endif %}{% if entry.credentialUrl starts with 'https://' or entry.credentialUrl starts with 'http://' %}<a href="{{ entry.credentialUrl }}" rel="noopener noreferrer">Voir le justificatif ↗</a>{% endif %}
{% elseif key == 'projects' %}<h3>{{ entry.title }}</h3>{% if entry.startDate or entry.endDate %}<p class="entry-date">{{ entry.startDate ? entry.startDate|date('m/Y') : 'Date non précisée' }} — {{ entry.endDate ? entry.endDate|date('m/Y') : 'Date non précisée' }}</p>{% endif %}{% if entry.description %}<p class="entry-description">{{ entry.description|nl2br }}</p>{% endif %}{% if entry.technologiesUsed %}<p class="entry-meta">{{ entry.technologiesUsed }}</p>{% endif %}{% if entry.url starts with 'https://' or entry.url starts with 'http://' %}<a href="{{ entry.url }}" rel="noopener noreferrer">Voir le projet ↗</a>{% endif %}
{% elseif key == 'languages' %}<h3>{{ entry.language }}</h3><p class="entry-meta">{{ entry.level }}</p>
{% elseif key == 'skills' %}<h3>{{ skill_names[entry.skillId] ?? 'Compétence' }}</h3><p class="entry-meta">{{ entry.level }}{% if entry.yearsExperience is not null %} · {{ entry.yearsExperience }} an(s) d’expérience{% endif %}</p>{% endif %}
